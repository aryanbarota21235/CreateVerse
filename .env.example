# --- Admin panel (/admin) ---
# Password for the CreateVerse team (REVIEW_ADMIN_PASSWORD also works)
ADMIN_PASSWORD=
# Supabase storage. Run supabase/schema.sql once. Without these, local dev uses .data/db.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Review suggestions (all optional, free tiers) ---
# Tried in this order; if none works, the free built-in templates are used.
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Any other OpenAI-compatible provider (e.g. OpenRouter https://openrouter.ai/api/v1)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional: Make.com webhook that notifies the team of enquiries and sign-ups
MAKE_WEBHOOK_URL=
