# --- Admin panel (/admin) ---
# Password for the CreateVerse team
ADMIN_PASSWORD=
# Supabase storage for clients, plans, sign-ups, payments and enquiries.
# Run supabase/schema.sql once. Without these, local dev stores data in .data/db.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Review QR service (/r/<slug>) ---
# Claude API key for review suggestions. Without it, built-in templates are used.
ANTHROPIC_API_KEY=
# Optional: model for suggestions (defaults to claude-opus-5-5). claude-haiku-5-5 is much cheaper.
REVIEW_AI_MODEL=

# Optional: Make.com webhook that notifies the team of enquiries and sign-ups
MAKE_WEBHOOK_URL=
