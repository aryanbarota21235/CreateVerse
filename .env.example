# --- Review QR service (/r/<slug> and /review-studio) ---
# Claude API key for generating review drafts. Without it, built-in templates are used.
ANTHROPIC_API_KEY=
# Optional: model for drafts (defaults to claude-opus-5-5). claude-haiku-5-5 is much cheaper.
REVIEW_AI_MODEL=
# Password for /review-studio (CreateVerse staff)
REVIEW_ADMIN_PASSWORD=
# Supabase (production storage). Without these, local dev stores data in .data/reviews.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
